{
  "name": "skelion",
  "version": "2.0.0",
  "description": "Zero-config, DOM-aware, SSR-safe skeleton system for React & Next.js",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "skelion": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles.css": "./dist/skeleton.css"
  },
  "files": [
    "dist",
    "cli/templates"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "keywords": [
    "react",
    "skeleton",
    "loading",
    "skeleton-ui",
    "skeleton-loader",
    "placeholder",
    "shimmer",
    "pulse",
    "nextjs",
    "ssr",
    "typescript",
    "zero-config",
    "dom-aware",
    "auto-skeleton",
    "cli"
  ],
  "author": "Bishawa Raj Bhujel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brajbhujel/Skelion.git"
  },
  "bugs": {
    "url": "https://github.com/brajbhujel/Skelion/issues"
  },
  "homepage": "https://skelion.bishawaraj.com.np",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-jest": "^29.4.9",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}